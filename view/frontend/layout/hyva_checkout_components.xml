                    <argument name="methodCode" xsi:type="string">payzen_multi</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Lyranetwork_Payzen/images/multi-logo.png</item>
                        </item>
                    </argument>
                </arguments>
            </block>

