declare(strict_types=1);

$options = $block->getAvailableOptions();
if ($options && count($options) > 0): ?>
<div class="payzen-fullcb" style="margin-bottom: 25px; width: 100%; padding: 12px 0px 12px 25px;">
    <fieldset style="padding-top: 10px;">
        <div class="field">
            <ul class="payzen-fullcb-payment-option payzen-payment-option" style="padding: 0;">
                <?php
                $oneOption = count($options) === 1;
                $first = true;

                foreach ($options as $key => $option) : ?>
                <li style="display: inline-block; padding-right: 20px; padding-bottom: 6px;">
                <?php if ($oneOption) : ?>
                    <input type="hidden"
                           id="option_<?= $escaper->escapeHtml($key); ?>"
                           value="<?= $escaper->escapeHtml($key); ?>"
                           name="payment[payzen_fullcb_option]" />
                <?php else : ?>
                    <input class="radio"
                           type="radio"
                           <?php if ($first) : ?> checked="checked"<?php endif; ?>
                           id="option_<?= $escaper->escapeHtml($key); ?>"
                           value="<?= $escaper->escapeHtml($key); ?>"
                           name="payment[payzen_fullcb_option]" />
                <?php
                    $first = false;
                endif;
                ?>

                    <label style="display: inline !important;"><?= $escaper->escapeHtml($option['label']); ?></label>

                    <table class="payzen_fullcb_review payzen_review" style="padding : 15px;">
                        <tbody>
                            <tr>
                                <td>
                                    <table>
                                        <tbody>
                                            <tr>
                                              <td><span><?= $escaper->escapeHtml(__('Order amount :')); ?></span></td>
                                              <td class="payzen_bold"><span><?= $escaper->escapeHtml($option['order_amount']); ?></span></td>
