                                              <td class="payzen_bold"><span><?= $escaper->escapeHtml($option['fees']); ?></span></td>
                                            </tr>
                                            <tr>
                                              <td colspan="2"><hr style="margin: 0px;"></td>
                                            </tr>
                                            <tr>
                                              <td><span><?= $escaper->escapeHtml(__('Total amount :')); ?></span></td>
                                              <td class="payzen_bold"><span><?= $escaper->escapeHtml($option['total_amount']); ?></span></td>
                                            </tr>
                                        </tbody>
                                    </table>
